# Build output (per-configuration, generated by the mk/cs-base.mk dispatcher)
/arm/
/arm-p/
/x86/
# Same, for the BBportHeadless sibling project (see BBportHeadless.pro) --
# its own build tree, not root-anchored since it's one level down.
BBportHeadless/arm/
BBportHeadless/arm-p/
BBportHeadless/x86/
# No translatable strings in a headless service with no UI -- nothing to
# check in here (unlike BBport.ts/.qm, which are committed).
BBportHeadless/translations/*.ts
BBportHeadless/translations/*.qm
*.o
*.bar

# Momentics-managed, auto-regenerated -- see config.pri's own header comment
config.pri

# Translation build byproducts (BBport.ts/.qm are checked in; these aren't)
translations/*.qm.tmp

# On-device diagnostic logs, pulled off the phone for debugging -- never
# meant to be committed
bbport_*_log.txt
bbport_debug.log
bbport_qml_load_error.txt

__pycache__/
*.pyc

# Editor/OS cruft
.DS_Store
Thumbs.db
*.swp

# Claude Code's own session state -- not part of the project
.claude/

# Eclipse/Momentics workspace-local preferences (machine-specific; .project
# and .cproject themselves ARE kept, so "Import Existing Project" still
# works for other Momentics users)
.settings/

