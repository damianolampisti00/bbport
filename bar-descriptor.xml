<qnx xmlns="http://www.qnx.com/schemas/application/1.0">

<!-- BlackBerry 10 application descriptor file.

    Specifies parameters for identifying, installing, and launching native applications on BlackBerry 10.

-->

    <!-- A universally unique application identifier. Must be unique across all BlackBerry 10 applications.
         Using a reverse DNS-style name as the id is recommended. (Eg. com.example.ExampleApplication.) Required. -->
    <id>it.bbport.client</id>
    <!-- entryPointId on the main UI asset + the headless one below, plus the
         matching <entryPoint> declarations further down, are only needed now
         that there are TWO binaries in this one .bar (see BBportHeadless/,
         step 4 of the persistent-login/headless-push plan): the invoke
         framework needs a name for each to route bb.action.system.STARTED to
         the right one. Only wired for Device-Debug so far, deliberately the
         smallest possible slice (a stub that only logs a boot-time line, see
         BBportHeadless/src/applicationheadless.cpp) to confirm
         _sys_run_headless/_sys_headless_nostop actually work on a real
         device before the real sync service is built on top of it;
         Device-Release gets the same treatment once that's confirmed. -->
    <configuration name="Device-Debug">
       <platformArchitecture>armle-v7</platformArchitecture>
       <asset entryPointId="BBportUi" path="arm/o.le-v7-g/BBport" entry="true" type="Qnx/Elf">BBport</asset>
       <asset entryPointId="BBportHeadless" path="BBportHeadless/arm/BBportHeadless" type="Qnx/Elf">BBportHeadless</asset>
    </configuration>
    <configuration name="Device-Release">
       <entryPointType>Qnx/Cascades</entryPointType>
       <platformArchitecture>armle-v7</platformArchitecture>
       <asset path="arm/o.le-v7/BBport.so" entry="true" type="Qnx/Elf">BBport.so</asset>
    </configuration>
    <configuration name="Device-Profile">
       <platformArchitecture>armle-v7</platformArchitecture>
       <asset path="arm-p/o.le-v7-g/BBport" entry="true" type="Qnx/Elf">BBport</asset>
    </configuration>
    <configuration name="Simulator-Debug">
       <platformArchitecture>x86</platformArchitecture>
       <asset path="x86/o-g/BBport" entry="true" type="Qnx/Elf">BBport</asset>
    </configuration>

    <entryPoint id="BBportUi">
        <name>BBportUi</name>
    </entryPoint>
    <entryPoint id="BBportHeadless">
        <name>BBportHeadless</name>
        <entryPointType>Qnx/Elf</entryPointType>
    </entryPoint>

    <!-- The name that is displayed in the BlackBerry 10 application installer.
         May have multiple values for each language. See samples or xsd schema file. Optional. -->
    <name>BBport</name>

    <!-- A string value of the format <0-999>.<0-999>.<0-999> that represents application version which can be used to check for application upgrade.
         Values can also be 1-part or 2-part. It is not necessary to have a 3-part value.
         An updated version of application must have a versionNumber value higher than the previous version. Required. -->
    <versionNumber>1.0.1</versionNumber>

    <!-- Fourth digit segment of the package version. First three segments are taken from the
         <versionNumber> element.  Must be an integer from 0 to 2^16-1 -->
    <buildId>15</buildId>

    <!-- A string value (such as "v1", "2.5", or "Alpha 1") that represents the version of the application, as it should be shown to users. Optional. -->
    <!-- <versionLabel></versionLabel> -->

    <!-- Description, displayed in the BlackBerry 10 application installer.
         May have multiple values for each language. See samples or xsd schema file. Optional. -->
    <description>Client di messaggistica BBport per BlackBerry 10.</description>

    <!-- Copyright information. Optional. -->
    <!-- <copyright></copyright> -->

    <!--  Name of author which is used for signing. Must match the developer name of your development certificate. -->
    <author>BBport</author>

    <!--  Unique author ID assigned by signing authority. Required if using debug tokens. -->
    <!-- <authorId>ABC1234YjsnUk235h</authorId> -->

    <initialWindow>
        <autoOrients>true</autoOrients>
        <systemChrome>none</systemChrome>
        <!-- Tried both true and false here, following a real BB10
             mm-renderer sample's documented requirement that the app's own
             window be transparent for the (always below in Z order) video
             window to show through; neither changed anything on-device,
             so whatever Cascades' ForeignWindowControl actually needs here
             is not simply this flag. Left unset (platform default). -->
    </initialWindow>

    <!--  The icon for the application, which should be 114x114. -->
    <icon>
        <image>icon.png</image>
    </icon>

    <asset path="icon.png">icon.png</asset>
    <asset path="assets">assets</asset>

    <!-- Locale support -->
    <asset path="translations" dest="qm">
        <include name="*.qm"/>
    </asset>

    <!-- Lets NotificationManager's InvokeRequest (attached to every
         incoming-message Notification, see notificationmanager.cpp)
         actually resolve to a target: without a matching invoke-target
         declaration here, InvokeRequest::setTarget()'s id has nothing
         registered to route to, and tapping the notification does nothing
         instead of foregrounding the app on that room. id must match
         kAppInvokeTarget in notificationmanager.cpp exactly. -->
    <invoke-target id="it.bbport.client.notification" system="false">
        <type>APPLICATION</type>
        <!-- Explicit now that there are two entry points declared (see
             BBportHeadless above); this one must resolve to the UI binary,
             never the headless one. -->
        <entry-point-id>BBportUi</entry-point-id>
        <filter>
            <action>bb.action.OPEN</action>
            <mime-type>application/x-bbport-room</mime-type>
        </filter>
    </invoke-target>

    <!-- Launches BBportHeadless (see entryPoint above) once at every device
         boot. The real structure, verified this session against
         BlackBerry's own official headlesserviceui/headlesservice sample
         (github.com/blackberry/Cascades-Samples), fetched directly since
         BlackBerry's own docs site for this is now dead. Currently just the
         step-4 smoke-test stub; grows into the real background sync service
         once this confirms the mechanism itself works on this device. -->
    <invoke-target id="it.bbport.client.headless" system="false">
        <invoke-target-type>application.headless</invoke-target-type>
        <invoke-target-name>BBport Background Sync</invoke-target-name>
        <entry-point-id>BBportHeadless</entry-point-id>
        <filter>
            <action>bb.action.system.STARTED</action>
            <mime-type>application/vnd.blackberry.system.event.STARTED</mime-type>
            <property var="uris" value="data://local"/>
        </filter>
    </invoke-target>

    <!-- Request permission to execute native code.  Required for native applications. -->
    <permission system="true">run_native</permission>
    <!-- Both needed for BBportHeadless (the invoke-target above) to actually
         launch and keep running as a background service, per
         github.com/blackberry/Cascades-Samples' headlesserviceui sample,
         which declares the identical pair for the identical purpose. -->
    <permission system="true">_sys_run_headless</permission>
    <permission system="true">_sys_headless_nostop</permission>
    <!-- Needed to talk to the Matrix homeserver over HTTPS. -->
    <permission>access_internet</permission>
    <!-- Needed to attach photos from the camera and the shared camera roll. -->
    <permission>use_camera</permission>
    <permission>access_shared</permission>
    <!-- Needed to record voice messages via bb.multimedia.AudioRecorder. -->
    <permission>record_audio</permission>
    <!-- Both official BlackBerry mm-renderer video samples (NDK-Samples
         VideoPlayback and VideoWindow) declare this; video playback here has
         reached MediaState::Started with dimensions detected but stayed
         black on a real device across every codec/resolution/window
         configuration tried, so testing whether this was simply a missing
         permission that never surfaced an explicit error. -->
    <permission>play_audio</permission>
    <!-- Needed for bb::platform::Notification (NotificationManager) to post
         Hub entries/LED/sound for incoming messages in rooms not currently
         open. -->
    <permission>post_notification</permission>
    <env var="LD_LIBRARY_PATH" value="app/native/lib:/usr/lib/qt4/lib"/>

</qnx>
